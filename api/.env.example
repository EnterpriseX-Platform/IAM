# ============================================
# ENVIRONMENT TEMPLATE
# Copy this file to .env.{environment} and fill in the values
# Available environments: local, dev, sit, uat, prod
# ============================================

# Environment name
ENV=local

# Server port
PORT=8080

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# Oracle Database (M_AGC - User/Master Data)
# ============================================
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=RESDB
ORACLE_USER=app
ORACLE_PASSWORD=

# ============================================
# ============================================

# ============================================
# Keycloak Configuration
# ============================================
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=iamx-realm
KEYCLOAK_CLIENT_ID=iamx-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ENABLED=true
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# ============================================
# JWT Configuration (when Keycloak disabled)
# ============================================
JWT_SECRET=
JWT_EXPIRY=24h

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=http://localhost:3000

# ============================================
# Security Settings (Production only)
# ============================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
